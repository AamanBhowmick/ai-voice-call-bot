# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── AI Provider ──────────────────────────────────────────────────────────────
# "azure_openai_realtime"  → bridges to Azure OpenAI Realtime (default, lowest latency)
# "custom"                 → uses your own STT + LLM + TTS keys (see sections below)
AI_PROVIDER=azure_openai_realtime

# ── Azure Communication Services ─────────────────────────────────────────────
# From ACS resource → Keys in the Azure Portal
ACS_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=xxxx

# The phone number you purchased in ACS (E.164 format)
ACS_PHONE_NUMBER=+12025550123

# ── Webhook & Callback ───────────────────────────────────────────────────────
# Public HTTPS URL of this server (your App Service URL / DevTunnel URL during dev)
CALLBACK_URI=https://your-server.com/api/callback

# WebSocket URL ACS connects to for audio streaming
WEBSOCKET_URL=wss://your-server.com/audio

# Random secret to validate Event Grid delivery headers (prevent fake events)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=your-random-secret-here

# ── AI Provider: Azure OpenAI Realtime ──────────────────────────────────────
# Used when AI_PROVIDER=azure_openai_realtime
# Requires: Azure OpenAI resource + deployment of gpt-4o-realtime-preview
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-realtime-preview
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Voice for the AI's TTS responses (when using Azure OpenAI Realtime)
# Options: alloy, echo, shimmer, fable, onyx, nova
OPENAI_VOICE=alloy

# System prompt — defines your bot's personality (optional, has a default)
# BOT_SYSTEM_PROMPT=You are a helpful sales assistant for Acme Corp...

# ── AI Provider: Custom STT + LLM + TTS ─────────────────────────────────────
# Used when AI_PROVIDER=custom
# Fill in the keys for whichever providers you plug into stt.ts / llm.ts / tts.ts

# STT (e.g. Azure Cognitive STT or Deepgram)
# AZURE_STT_KEY=your-azure-stt-key
# AZURE_STT_REGION=eastus
# DEEPGRAM_API_KEY=your-deepgram-key

# LLM (e.g. Gemini, OpenAI, Anthropic)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# TTS (e.g. Azure Neural TTS or ElevenLabs)
# AZURE_TTS_KEY=your-azure-tts-key
# AZURE_TTS_REGION=eastus
# ELEVENLABS_API_KEY=your-elevenlabs-key
